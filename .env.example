# ==============================================================================
# EduNexa Environment Configuration Template (.env.example)
# Copy this file to .env and supply your local or hosted credentials.
# NEVER commit .env with real credentials to source control.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (Hosted PostgreSQL or local container)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=prefer
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edunexa_dev?schema=public"

# Cryptographic Token Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET="edunexa_dev_access_secret_do_not_use_in_prod_12345"
JWT_REFRESH_SECRET="edunexa_dev_refresh_secret_do_not_use_in_prod_67890"

# AI Provider API Configuration (Optional in local dev, mock fallback enabled)
AI_PROVIDER_API_KEY=""
AI_PROVIDER_MODEL="gemini-2.0-flash"

# System Telemetry & Logging
LOG_LEVEL="debug"
