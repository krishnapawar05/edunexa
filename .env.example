# ==============================================================================
# EduNexa Environment Configuration Template (.env.example)
# Copy this file to .env and supply your local or Railway credentials.
# NEVER commit .env with real credentials to source control.
# ==============================================================================

# Application Environment
NODE_ENV=production

# Server Port (Railway automatically sets PORT, defaults to 5000 locally)
PORT=5000

# Client Origin (In single-service deployment, same domain is used. In split deployment, specify frontend domain)
CLIENT_ORIGIN=http://localhost:5173

# Database Connection
# In Railway: Automatically injected when you provision a PostgreSQL service.
# Format: postgresql://postgres:PASSWORD@HOST:PORT/railway
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edunexa_dev?schema=public"

# Cryptographic Token Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET="edunexa_super_secure_production_access_secret_key_32_chars_min"
JWT_REFRESH_SECRET="edunexa_super_secure_production_refresh_secret_key_32_chars_min"

# Frontend Remote API URL (Only needed if deploying frontend separately on Vercel/Netlify; leave empty for unified deployment)
# VITE_API_BASE_URL="https://your-backend.up.railway.app"

# AI Provider API Configuration (Optional in local dev, mock fallback enabled)
AI_PROVIDER_API_KEY=""
AI_PROVIDER_MODEL="gemini-2.0-flash"

# System Telemetry & Logging
LOG_LEVEL="info"
