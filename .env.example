# ==============================================================================
# EduNexa Environment Configuration Template (.env.example)
# Target Platform: Vercel + Prisma Postgres + Vercel Blob
# NEVER commit .env with real production credentials to source control.
# ==============================================================================

# Application Environment (development | production | test)
NODE_ENV=production

# Server Port (Defaults to 5000 in local standalone mode; auto-managed on Vercel)
PORT=5000

# Client Application URL / CORS Origin
# In unified Vercel deployment: Set to your Vercel project domain (e.g., https://edunexa.vercel.app)
# In local development: http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
VITE_APP_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# PRISMA POSTGRES DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# 1. DATABASE_URL / DATABASE_URL_POOLED:
#    Connection-pooled connection string used for serverless application queries.
#    Auto-injected by Vercel Prisma Postgres Integration.
DATABASE_URL="postgresql://postgres:root@localhost:5432/edunexa_dev?schema=public"
DATABASE_URL_POOLED="postgresql://postgres:root@localhost:5432/edunexa_dev?schema=public"

# 2. DIRECT_URL:
#    Direct, unpooled PostgreSQL connection string required for migrations (prisma migrate deploy).
#    In local dev: Same as DATABASE_URL.
#    In Prisma Postgres: Direct database connection URL (non-pooling).
DIRECT_URL="postgresql://postgres:root@localhost:5432/edunexa_dev?schema=public"

# ------------------------------------------------------------------------------
# VERCEL BLOB STORAGE
# ------------------------------------------------------------------------------
# Vercel Blob Read/Write Token for persistent cloud file uploads.
# Automatically provisioned when you add a Vercel Blob store in the Vercel dashboard.
# Leave blank in offline local dev to automatically use local disk (uploads/ directory).
BLOB_READ_WRITE_TOKEN=""

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Cryptographic secrets used for signing access and refresh tokens.
# Must be at least 32 characters in production.
JWT_ACCESS_SECRET="edunexa_super_secure_production_access_secret_key_32_chars_min"
JWT_REFRESH_SECRET="edunexa_super_secure_production_refresh_secret_key_32_chars_min"

# ------------------------------------------------------------------------------
# ARTIFICIAL INTELLIGENCE (Gemini / AI Tutoring & Question Generator)
# ------------------------------------------------------------------------------
# Google Gemini API Key. Optional in development (mock responses active).
AI_PROVIDER_API_KEY=""
AI_PROVIDER_MODEL="gemini-2.0-flash"

# ------------------------------------------------------------------------------
# RAZORPAY PAYMENT GATEWAY (Fee Collection)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_test_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"
RAZORPAY_MODE="test"

# ------------------------------------------------------------------------------
# TELEMETRY & LOGGING
# ------------------------------------------------------------------------------
LOG_LEVEL="info"
