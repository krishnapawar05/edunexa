# ==============================================================================
# EduNexa Server Environment Configuration Template (server/.env.example)
# Target Platform: Vercel Functions + Prisma Postgres + Vercel Blob
# ==============================================================================

NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Prisma Postgres Connection Strings
DATABASE_URL="postgresql://postgres:root@localhost:5432/edunexa_dev?schema=public"
DATABASE_URL_POOLED="postgresql://postgres:root@localhost:5432/edunexa_dev?schema=public"
DIRECT_URL="postgresql://postgres:root@localhost:5432/edunexa_dev?schema=public"

# Vercel Blob Storage Token (leave blank for local uploads/ fallback)
BLOB_READ_WRITE_TOKEN=""

# JWT Secrets
JWT_ACCESS_SECRET="edunexa_dev_access_secret_do_not_use_in_prod_12345"
JWT_REFRESH_SECRET="edunexa_dev_refresh_secret_do_not_use_in_prod_67890"

# AI Provider API Configuration
AI_PROVIDER_API_KEY=""
AI_PROVIDER_MODEL="gemini-2.0-flash"

# System Telemetry
LOG_LEVEL="debug"

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_test_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"
RAZORPAY_MODE="test"
