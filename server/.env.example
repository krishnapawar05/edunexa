# ==============================================================================
# EduNexa Server Environment Configuration Template (server/.env.example)
# ==============================================================================

# Application Environment
# Default: production in cloud containers; development for local server debugging
# NODE_ENV=production

# Server Port (Railway automatically sets PORT, defaults to 5000 locally)
# PORT=5000

# Client Origin (CORS)
# Defaults to same-origin / Railway public domain in production
# CLIENT_ORIGIN=http://localhost:5173

# Database Connection
# In Railway: Use ${{Postgres.DATABASE_URL}}
# In Local Dev: postgresql://postgres:root@localhost:5432/edunexa_dev?schema=public
# DATABASE_URL="postgresql://postgres:root@localhost:5432/edunexa_dev?schema=public"

# Cryptographic Token Secrets (Must be at least 32 characters in production)
# JWT_ACCESS_SECRET="edunexa_production_grade_access_secret_1234567890_secure_key"
# JWT_REFRESH_SECRET="edunexa_production_grade_refresh_secret_1234567890_secure_key"

# AI Provider API Configuration
# AI_PROVIDER_API_KEY=""
# AI_PROVIDER_MODEL="gemini-2.0-flash"

# System Telemetry & Logging
# LOG_LEVEL="info"

# Razorpay Payment Gateway (Test Mode)
# RAZORPAY_KEY_ID=rzp_test_placeholder
# RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder
# RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder
# RAZORPAY_MODE=test
