// ============================================================================
// EXAMINATION ADMIT CARD MANAGEMENT (SECTION 5)
// ============================================================================

enum AdmitCardStatus {
  GENERATED
  PUBLISHED
  WITHHELD
  REVOKED
}

enum ClearanceStatus {
  CLEARED
  PENDING_FEES
  PENDING_ATTENDANCE
  PENDING_ADMIN
  BLOCKED
}

model AdmitCard {
  id                    String          @id @default(uuid())
  schoolId              String
  studentProfileId      String
  academicSessionId     String
  examTitle             String
  examType              String
  admitCardNumber       String          @unique
  rollNumber            String?
  className             String
  sectionName           String?
  centerName            String          @default("Main Campus Examination Center")
  roomNumber            String?         @default("Examination Hall A")
  status                AdmitCardStatus @default(GENERATED)
  clearanceStatus       ClearanceStatus @default(CLEARED)
  clearanceDetails      Json?
  candidateInstructions String?         @default("1. Candidates must arrive at the examination center at least 30 minutes before the start time.\n2. No candidate will be allowed entry into the examination hall without this official Admit Card and Student ID badge.\n3. Electronic devices, programmable calculators, cellular phones, and unauthorized notes are strictly prohibited.\n4. Candidates must adhere strictly to the institutional examination code of conduct.")
  qrToken               String          @unique
  publishedAt           DateTime?
  publishedByUserId     String?
  issuedAt              DateTime        @default(now())
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  school                School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student               StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  academicSession       AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([schoolId, examTitle])
  @@index([studentProfileId])
  @@index([qrToken])
}

// ============================================================================
// SECTION 6: EXAMINATION, QUESTION PAPER & ONLINE QUIZ MANAGEMENT
// ============================================================================

model QuestionBankItem {
  id               String             @id @default(uuid())
  schoolId         String
  subjectId        String
  classId          String?
  chapter          String?
  topic            String?
  difficulty       QuestionDifficulty @default(MEDIUM)
  questionType     QuestionType
  questionText     String
  marks            Float              @default(1.0)
  negativeMarks    Float              @default(0.0)
  explanation      String?
  imageUrl         String?
  metadata         Json?
  createdById      String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  school           School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject          Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class            Class?             @relation(fields: [classId], references: [id], onDelete: SetNull)
  paperItems       QuestionPaperItem[]

  @@index([schoolId, subjectId])
  @@index([schoolId, difficulty])
  @@index([schoolId, questionType])
}

model QuestionPaper {
  id                 String              @id @default(uuid())
  schoolId           String
  academicSessionId  String?
  examScheduleId     String?
  subjectId          String
  classId            String?
  title              String
  instructions       String?
  durationMinutes    Int                 @default(60)
  totalMarks         Float               @default(50.0)
  passingMarks       Float               @default(20.0)
  status             QuestionPaperStatus @default(DRAFT)
  randomizeQuestions Boolean             @default(false)
  randomizeOptions   Boolean             @default(false)
  sections           Json?
  createdById        String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject            Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class              Class?              @relation(fields: [classId], references: [id], onDelete: SetNull)
  examSchedule       ExamSchedule?       @relation(fields: [examScheduleId], references: [id], onDelete: SetNull)
  items              QuestionPaperItem[]
  attempts           AssessmentAttempt[]

  @@index([schoolId, subjectId])
  @@index([schoolId, status])
}

model QuestionPaperItem {
  id                 String            @id @default(uuid())
  questionPaperId    String
  questionBankItemId String?
  sectionName        String            @default("Section A")
  orderIndex         Int               @default(0)
  questionText       String
  questionType       QuestionType
  marks              Float             @default(1.0)
  negativeMarks      Float             @default(0.0)
  explanation        String?
  imageUrl           String?
  metadata           Json?

  questionPaper      QuestionPaper     @relation(fields: [questionPaperId], references: [id], onDelete: Cascade)
  bankItem           QuestionBankItem? @relation(fields: [questionBankItemId], references: [id], onDelete: SetNull)
  answers            AssessmentAnswer[]

  @@index([questionPaperId, orderIndex])
}

model AssessmentAttempt {
  id               String                  @id @default(uuid())
  schoolId         String
  questionPaperId  String
  studentProfileId String
  attemptNumber    Int                     @default(1)
  startedAt        DateTime                @default(now())
  submittedAt      DateTime?
  durationMinutes  Int
  isAutoSubmitted  Boolean                 @default(false)
  scoreObtained    Float?
  percentage       Float?
  isPassed         Boolean?
  status           AssessmentAttemptStatus @default(IN_PROGRESS)
  evaluatedById    String?
  evaluatedAt      DateTime?
  teacherFeedback  String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  school           School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  questionPaper    QuestionPaper           @relation(fields: [questionPaperId], references: [id], onDelete: Cascade)
  student          StudentProfile          @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  answers          AssessmentAnswer[]

  @@unique([questionPaperId, studentProfileId, attemptNumber])
  @@index([schoolId, status])
  @@index([studentProfileId])
}

model AssessmentAnswer {
  id               String            @id @default(uuid())
  attemptId        String
  paperItemId      String
  studentAnswer    Json?
  isEvaluated      Boolean           @default(false)
  isAutoEvaluated  Boolean           @default(false)
  marksAwarded     Float?
  maxMarks         Float
  teacherRemarks   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  attempt          AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  paperItem        QuestionPaperItem @relation(fields: [paperItemId], references: [id], onDelete: Cascade)

  @@unique([attemptId, paperItemId])
  @@index([attemptId])
}

// ============================================================================
// SECTION 7: PROFESSIONAL MARKSHEET & REPORT CARD GENERATION
// ============================================================================

enum MarksheetStatus {
  DRAFT
  ISSUED
  PUBLISHED
  WITHHELD
  CORRECTED
  CANCELLED
}

model MarksheetTemplate {
  id                    String      @id @default(uuid())
  schoolId              String
  name                  String
  examType              String?     @default("ALL")
  isDefault             Boolean     @default(false)
  isActive              Boolean     @default(true)
  layoutStyle           String      @default("FORMAL_CBSE")
  primaryColor          String      @default("#1e3a8a")
  secondaryColor        String      @default("#d97706")
  headerTextColor       String      @default("#ffffff")
  logoUrl               String?
  stampUrl              String?
  principalSignatureUrl String?
  teacherSignatureUrl   String?
  showStudentPhoto      Boolean     @default(true)
  showAttendance        Boolean     @default(true)
  showRank              Boolean     @default(false)
  showDivision          Boolean     @default(true)
  showPracticalMarks    Boolean     @default(true)
  gradingScaleJson      Json?
  passingCriteriaJson   Json?
  customRemarks         String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  school                School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  marksheets            Marksheet[]

  @@index([schoolId, isDefault])
}

model Marksheet {
  id                   String          @id @default(uuid())
  schoolId             String
  studentProfileId     String
  academicSessionId    String
  templateId           String?
  examTitle            String
  examType             String          @default("ANNUAL")
  marksheetNumber      String          @unique
  version              Int             @default(1)
  isLatest             Boolean         @default(true)
  className            String
  sectionName          String?
  rollNumber           String?
  status               MarksheetStatus @default(ISSUED)
  totalMaxMarks        Float
  totalMarksObtained   Float
  overallPercentage    Float
  grade                String
  division             String?
  isPassed             Boolean         @default(true)
  attendancePercentage Float?
  totalPresentDays     Int?
  totalWorkingDays     Int?
  classTeacherRemarks  String?
  principalRemarks     String?
  subjectMarksSnapshot Json
  studentSnapshot      Json?
  schoolSnapshot       Json?
  qrToken              String          @unique
  correctionReason     String?
  correctedByUserId    String?
  originalMarksheetId  String?
  publishedAt          DateTime?
  publishedByUserId    String?
  issuedAt             DateTime        @default(now())
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  school               School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student              StudentProfile             @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  academicSession      AcademicSession            @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  template             MarksheetTemplate?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  audits               MarksheetCorrectionAudit[]

  @@index([schoolId, status])
  @@index([schoolId, examTitle])
  @@index([studentProfileId])
  @@index([academicSessionId])
  @@index([qrToken])
}

model MarksheetCorrectionAudit {
  id                String    @id @default(uuid())
  schoolId          String
  marksheetId       String
  initiatedByUserId String
  approvedByUserId  String?
  reason            String
  previousSnapshot  Json
  updatedSnapshot   Json
  previousVersion   Int
  newVersion        Int
  status            String    @default("APPROVED")
  createdAt         DateTime  @default(now())

  school            School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  marksheet         Marksheet @relation(fields: [marksheetId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([marksheetId])
}
