datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum PlatformRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  PRINCIPAL
  TEACHER
  STUDENT
  PARENT
  HR_STAFF
  ACCOUNTS
  EXAM_COORDINATOR
  LIBRARIAN
}

enum TenantStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum StudentStatus {
  APPLICANT
  ACTIVE
  GRADUATED
  TRANSFERRED
  INACTIVE
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  PROBATION
  RESIGNED
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  APPROVED_LEAVE
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_SELECT
  TRUE_FALSE
  FILL_IN_BLANKS
  SHORT_ANSWER
  LONG_ANSWER
  DESCRIPTIVE
  MATCH_THE_FOLLOWING
  NUMERICAL
  FILE_UPLOAD
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionPaperStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssessmentAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATED
  PUBLISHED
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ExamStatus {
  SCHEDULED
  MARKS_DRAFT
  MARKS_SUBMITTED
  PUBLISHED
  ARCHIVED
}

enum FeePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  REFUNDED
}

enum PaymentTxnStatus {
  CREATED
  ATTEMPTED
  SUCCESS
  FAILED
  REFUNDED
}

enum EventAudience {
  ALL
  STUDENTS_ONLY
  PARENTS_ONLY
  STAFF_ONLY
  SPECIFIC_CLASS
}

enum CardStatus {
  ACTIVE
  EXPIRED
  REVOKED
  LOST
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  DOCUMENTS_REQUIRED
  APPROVED
  REJECTED
  WAITLISTED
  ENROLLED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  FOLLOW_UP_REQUIRED
  INTERESTED
  APPLICATION_STARTED
  APPLICATION_SUBMITTED
  CONVERTED
  CLOSED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
  FAILED
}

// -------------------------------------------------------------
// CORE TENANCY & AUTHENTICATION
// -------------------------------------------------------------

model School {
  id              String       @id @default(uuid())
  slug            String       @unique
  name            String
  code            String       @unique
  logoUrl         String?
  motto           String?
  email           String
  phone           String
  address         String
  city            String
  state           String
  postalCode      String
  country         String       @default("India")
  websiteUrl      String?
  status          TenantStatus @default(PENDING_APPROVAL)
  establishedYear Int?
  brandingConfig  Json?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  memberships       UserMembership[]
  academicSessions  AcademicSession[]
  classes           Class[]
  departments       Department[]
  notices           Notice[]
  events            SchoolEvent[]
  feeStructures     FeeStructure[]
  subscriptions     Subscription[]
  auditLogs         AuditLog[]
  admissionApplications AdmissionApplication[]
  admissionEnquiries    AdmissionEnquiry[]
  notifications     Notification[]
  invitations       AccountInvitation[]
  paymentTransactions PaymentTransaction[]
  websiteContent      WebsiteContent?
  highlights          SchoolHighlight[]
  facilities          SchoolFacility[]
  achievements        StudentAchievement[]
  testimonials        ParentTestimonial[]
  downloadableDocs    DownloadableDocument[]
  galleryCategories   GalleryCategory[]
  galleryItems        GalleryItem[]
  idCardTemplates     IdCardTemplate[]
  virtualIdCards      VirtualIdCard[]
  admitCards          AdmitCard[]
  questionBankItems   QuestionBankItem[]
  questionPapers      QuestionPaper[]
  assessmentAttempts  AssessmentAttempt[]
  marksheetTemplates  MarksheetTemplate[]
  marksheets          Marksheet[]
  marksheetAudits     MarksheetCorrectionAudit[]
  libraryBooks        LibraryBook[]
  bookIssues          BookIssue[]
  meetings            Meeting[]
  communicationMsgs   CommunicationMessage[]
  studentRemarks      StudentRemark[]
  conversations       Conversation[]
  messageReports      MessageReport[]
  communicationAudits CommunicationAuditLog[]
  commPermissionConfig CommunicationPermissionConfig?
  calendarEvents      CalendarEvent[]
  googleIntegration   GoogleWorkspaceIntegration?
  studentCertificates StudentCertificate[]
  documentAccessLogs  DocumentAccessLog[]
  librarySetting      LibrarySetting?
  staffPayrolls       StaffPayroll[]
  transportVehicles   TransportVehicle[]
  transportDrivers    TransportDriver[]
  transportRoutes     TransportRoute[]
  transportAllocations StudentTransportAllocation[]
  inventoryCategories InventoryCategory[]
  inventoryItems      InventoryItem[]
  inventoryTransactions InventoryTransaction[]
  chatbotFaqs         ChatbotFAQ[]
  chatbotConfig       ChatbotConfiguration?
  chatbotEscalations  ChatbotEscalation[]
  pageSeos            PageSEO[]
  marketingConfig     MarketingIntegration?
  blogArticles        BlogArticle[]
  marketingBanners    MarketingBanner[]
  callbackRequests    CallbackRequest[]
  newsletterSubscribers NewsletterSubscriber[]
  leadFollowUps       LeadFollowUp[]
  analyticsEvents     AnalyticsEvent[]
  notificationEventConfigs   NotificationEventConfig[]
  notificationTemplates      NotificationTemplate[]
  notificationDeliveryLogs   NotificationDeliveryLog[]
  notificationProviderConfig NotificationProviderConfig?
  modulePermissions          ModulePermission[]
  backupRecords              BackupRecord[]
  marksheetPublicationRequests MarksheetPublicationRequest[]
  secureFiles                SecureFile[]

  @@index([slug])
  @@index([status])
}

model User {
  id                 String       @id @default(uuid())
  email              String       @unique
  username           String?      @unique
  passwordHash       String
  firstName          String
  lastName           String
  phone              String?
  avatarUrl          String?
  isActive           Boolean      @default(true)
  mustChangePassword Boolean      @default(false)
  lastLoginAt        DateTime?
  passwordResetAt    DateTime?
  passwordChangedAt  DateTime?
  accountLocked      Boolean      @default(false)
  failedLoginAttempts Int         @default(0)
  lockoutUntil       DateTime?
  tokenVersion       Int          @default(0)

  // Section 17 MFA / OTP Security
  mfaEnabled         Boolean      @default(false)
  mfaSecret          String?
  mfaOtpCode         String?
  mfaOtpExpiresAt    DateTime?
  mfaRecoveryCodes   String[]     @default([])
  mfaMethod          String       @default("EMAIL_OTP")

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  memberships        UserMembership[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  invitations        AccountInvitation[]
  passwordResetTokens PasswordResetToken[]
  paymentTransactions PaymentTransaction[]
  conversationParticipants ConversationParticipant[]
  chatMessages             ChatMessage[]
  chatMessageReceipts      ChatMessageReceipt[]
  reportedMessages         MessageReport[]          @relation("ReportedByUser")
  moderatedMessages        MessageReport[]          @relation("ModeratedByUser")
  communicationAudits      CommunicationAuditLog[]
  calendarEventsCreated    CalendarEvent[]
  conversationsCreated     Conversation[]
  documentsUploaded        DownloadableDocument[]   @relation("DocumentsUploadedByUser")
  certificatesIssued       StudentCertificate[]     @relation("CertificatesIssuedByUser")
  documentAccessLogs       DocumentAccessLog[]
  bookIssuesIssued         BookIssue[]              @relation("BookIssuesIssuedByUser")
  backupsInitiated         BackupRecord[]
  filesUploaded            SecureFile[]             @relation("FilesUploadedByUser")

  @@index([email])
  @@index([username])
}

model UserMembership {
  id          String        @id @default(uuid())
  userId      String
  schoolId    String
  role        PlatformRole
  isPrimary   Boolean       @default(true)
  isActive    Boolean       @default(true)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  school      School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  studentProfile StudentProfile?
  staffProfile   StaffProfile?
  parentLinks    ParentStudentLink[] @relation("ParentMembership")

  @@unique([userId, schoolId, role])
  @@index([schoolId, role])
  @@index([userId])
}

model AccountInvitation {
  id              String           @id @default(uuid())
  schoolId        String
  userId          String
  role            PlatformRole
  email           String?
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  sentAt          DateTime?
  lastAttemptAt   DateTime?
  deliveryStatus  String?
  deliveryError   String?
  invitedByUserId String?
  isAssisted      Boolean          @default(false)
  assistedCode    String?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([userId])
  @@index([tokenHash])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Subscription {
  id              String       @id @default(uuid())
  schoolId        String
  planName        String
  startDate       DateTime
  endDate         DateTime
  trialEndsAt     DateTime?
  status          TenantStatus @default(ACTIVE)
  maxStudents     Int          @default(500)
  maxStaff        Int          @default(50)
  billingCycle    String       @default("ANNUAL")
  isSimulated     Boolean      @default(true)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  school          School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model AcademicSession {
  id          String       @id @default(uuid())
  schoolId    String
  name        String
  startDate   DateTime
  endDate     DateTime
  isCurrent   Boolean      @default(false)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments StudentEnrollment[]
  examSchedules ExamSchedule[]
  admitCards    AdmitCard[]
  marksheets    Marksheet[]
  downloadableDocs DownloadableDocument[]
  certificates     StudentCertificate[]

  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
}

model Department {
  id          String       @id @default(uuid())
  schoolId    String
  name        String
  description String?

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff       StaffProfile[]

  @@unique([schoolId, name])
}

model Class {
  id          String       @id @default(uuid())
  schoolId    String
  name        String
  code        String
  stage       String?

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections    Section[]
  subjects    Subject[]
  enrollments StudentEnrollment[]
  feeStructures FeeStructure[]
  questionBankItems QuestionBankItem[]
  questionPapers    QuestionPaper[]
  downloadableDocs  DownloadableDocument[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model Section {
  id          String       @id @default(uuid())
  classId     String
  name        String
  capacity    Int          @default(40)

  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollments StudentEnrollment[]
  timetables  TimetableSlot[]
  attendances AttendanceRecord[]
  quizzes     Quiz[]
  assignments Assignment[]

  @@unique([classId, name])
}

model Subject {
  id          String       @id @default(uuid())
  classId     String
  name        String
  code        String
  isOptional  Boolean      @default(false)

  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  assignments TeacherAssignment[]
  quizzes     Quiz[]
  examSchedules ExamSchedule[]
  learningResources LearningResource[]
  questionBankItems QuestionBankItem[]
  questionPapers    QuestionPaper[]

  @@unique([classId, code])
}

model StudentProfile {
  id              String        @id @default(uuid())
  membershipId    String        @unique
  admissionNumber String        @unique
  dateOfBirth     DateTime
  gender          String
  bloodGroup      String?
  address         String?
  medicalNotes    String?
  emergencyPhone  String
  status          StudentStatus @default(ACTIVE)
  photoUrl        String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  membership      UserMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  virtualIdCard   VirtualIdCard?
  enrollments     StudentEnrollment[]
  parentLinks     ParentStudentLink[]
  attendance      AttendanceRecord[]
  quizAttempts    QuizAttempt[]
  examMarks       ExamMark[]
  feeInvoices     FeeInvoice[]
  submissions     AssignmentSubmission[]
  admitCards      AdmitCard[]
  assessmentAttempts AssessmentAttempt[]
  marksheets      Marksheet[]
  bookIssues      BookIssue[]
  meetings        Meeting[]
  certificates    StudentCertificate[]
  communicationMsgs CommunicationMessage[]
  remarks         StudentRemark[]
  transportAllocations StudentTransportAllocation[]

  @@index([admissionNumber])
  @@index([status])
}

model ParentStudentLink {
  id                 String         @id @default(uuid())
  parentMembershipId String
  studentProfileId   String
  relationship       String
  isPrimaryContact   Boolean        @default(false)

  parentMembership   UserMembership @relation("ParentMembership", fields: [parentMembershipId], references: [id], onDelete: Cascade)
  studentProfile     StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([parentMembershipId, studentProfileId])
  @@index([parentMembershipId])
  @@index([studentProfileId])
}

model AdmissionApplication {
  id                      String            @id @default(uuid())
  schoolId                String
  applicationNumber       String            @unique
  studentFirstName        String
  studentLastName         String
  dateOfBirth             DateTime
  gender                  String
  bloodGroup              String?
  applyingClass           String
  academicSession         String?           @default("2026-2027")
  studentEmail            String?
  guardianName            String
  guardianRelationship    String
  guardianEmail           String
  guardianPhone           String
  residentialAddress      String
  previousSchool          String?
  previousMarksPercentage Float?
  documents               Json?
  missingDocuments        Json?
  enrolledStudentProfileId String?
  status                  ApplicationStatus @default(SUBMITTED)
  reviewedByUserId        String?
  reviewNotes             String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  school                  School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([applicationNumber])
}

model AdmissionEnquiry {
  id            String        @id @default(uuid())
  schoolId      String
  enquiryNumber String        @unique
  parentName    String
  studentName   String
  email         String
  phone         String
  applyingClass String
  message       String?
  status        EnquiryStatus @default(NEW)
  internalNotes String?
  source        String        @default("WEBSITE_POPUP")
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmTerm       String?
  utmContent    String?
  assignedStaffId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  leadFollowUps LeadFollowUp[]

  @@index([schoolId, status])
  @@index([enquiryNumber])
}

model StudentEnrollment {
  id                 String          @id @default(uuid())
  studentProfileId   String
  academicSessionId  String
  classId            String
  sectionId          String
  rollNumber         Int?
  enrolledAt         DateTime        @default(now())

  student            StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  academicSession    AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  class              Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  section            Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, academicSessionId])
  @@index([classId, sectionId, academicSessionId])
}

model StaffProfile {
  id              String           @id @default(uuid())
  membershipId    String           @unique
  employeeId      String           @unique
  departmentId    String?
  designation     String
  joiningDate     DateTime
  employmentStatus EmploymentStatus @default(ACTIVE)
  salaryGrade     String?
  photoUrl        String?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  membership      UserMembership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  department      Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  virtualIdCard   VirtualIdCard?
  teacherAssignments TeacherAssignment[]
  staffAttendance StaffAttendance[]
  leaveRequests   StaffLeaveRequest[]
  staffQuizAttempts StaffQuizAttempt[]
  payrolls        StaffPayroll[]

  @@index([employeeId])
}

model TeacherAssignment {
  id              String       @id @default(uuid())
  staffProfileId  String
  subjectId       String
  isLeadTeacher   Boolean      @default(false)

  staff           StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  subject         Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([staffProfileId, subjectId])
}

model VirtualIdCard {
  id                 String          @id @default(uuid())
  schoolId           String?
  studentProfileId   String?         @unique
  staffProfileId     String?         @unique
  templateId         String?
  cardNumber         String          @unique
  verificationToken  String          @unique
  dataHash           String?
  status             CardStatus      @default(ACTIVE)
  issuedAt           DateTime        @default(now())
  expiresAt          DateTime?
  revokedAt          DateTime?
  revocationReason   String?

  school             School?         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  template           IdCardTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  student            StudentProfile? @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  staff              StaffProfile?   @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([templateId])
  @@index([verificationToken])
  @@index([cardNumber])
  @@index([status])
}

model IdCardTemplate {
  id                 String          @id @default(uuid())
  schoolId           String
  name               String
  description        String?
  targetRole         String          @default("ALL") // "STUDENT", "TEACHER", "STAFF", "ALL"
  isDefault          Boolean         @default(false)
  isActive           Boolean         @default(true)
  primaryColor       String          @default("#1e3a8a") // Deep Navy
  secondaryColor     String          @default("#d97706") // Academic Gold
  headerTextColor    String          @default("#ffffff")
  cardOrientation    String          @default("LANDSCAPE") // "LANDSCAPE" | "PORTRAIT"
  showBloodGroup     Boolean         @default(true)
  showParentContact  Boolean         @default(true)
  showEmergencyPhone Boolean         @default(true)
  showPrincipalSign  Boolean         @default(true)
  showSchoolSeal     Boolean         @default(true)
  showBarcode        Boolean         @default(false)
  customTermsText    String?
  layoutConfig       Json?           // Fine-grained field coordinates and styling
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  school             School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  virtualIdCards     VirtualIdCard[]

  @@index([schoolId])
}

model AttendanceRecord {
  id               String           @id @default(uuid())
  studentProfileId String
  sectionId        String
  date             DateTime         @db.Date
  status           AttendanceStatus
  remarks          String?
  markedByUserId   String
  auditTrail       Json?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  student          StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  section          Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, date])
  @@index([sectionId, date])
}

model StaffAttendance {
  id             String           @id @default(uuid())
  staffProfileId String
  date           DateTime         @db.Date
  status         AttendanceStatus
  checkInTime    DateTime?
  checkOutTime   DateTime?
  remarks        String?

  staff          StaffProfile     @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@unique([staffProfileId, date])
}

model StaffLeaveRequest {
  id             String       @id @default(uuid())
  staffProfileId String
  leaveType      String
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  reason         String
  status         String       @default("PENDING")
  approvedBy     String?
  approvedAt     DateTime?

  staff          StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
}

model Quiz {
  id               String       @id @default(uuid())
  schoolId         String
  subjectId        String
  sectionId        String?
  title            String
  instructions     String?
  durationMinutes  Int
  totalMarks       Float
  passingMarks     Float
  status           QuizStatus   @default(DRAFT)
  opensAt          DateTime
  closesAt         DateTime
  maxAttempts      Int          @default(1)
  randomizeQuestions Boolean    @default(true)
  negativeMarking  Float        @default(0.0)
  releaseGradesImmediately Boolean @default(false)
  isStaffTraining  Boolean      @default(false)

  createdByUserId  String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  subject          Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  section          Section?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  questions        QuizQuestion[]
  attempts         QuizAttempt[]

  @@index([schoolId, status])
  @@index([opensAt, closesAt])
}

model QuizQuestion {
  id               String       @id @default(uuid())
  quizId           String
  questionText     String
  questionType     QuestionType
  marks            Float        @default(1.0)
  negativeMarks    Float        @default(0.0)
  orderIndex       Int
  explanation      String?
  imageUrl         String?

  quiz             Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  choices          QuizQuestionChoice[]
  answers          QuizAttemptAnswer[]

  @@index([quizId, orderIndex])
}

model QuizQuestionChoice {
  id             String       @id @default(uuid())
  questionId     String
  choiceText     String
  isCorrect      Boolean
  orderIndex     Int

  question       QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuizAttempt {
  id               String       @id @default(uuid())
  quizId           String
  studentProfileId String
  attemptNumber    Int          @default(1)
  startedAt        DateTime     @default(now())
  submittedAt      DateTime?
  timeTakenSeconds Int?
  scoreObtained    Float?
  percentage       Float?
  isPassed         Boolean?
  isGraded         Boolean      @default(false)
  suspiciousEvents Json?

  quiz             Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student          StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  answers          QuizAttemptAnswer[]

  @@unique([quizId, studentProfileId, attemptNumber])
  @@index([quizId, studentProfileId])
}

model QuizAttemptAnswer {
  id               String       @id @default(uuid())
  attemptId        String
  questionId       String
  selectedChoiceId String?
  textAnswer       String?
  isCorrect        Boolean?
  marksAwarded     Float?
  teacherFeedback  String?

  attempt          QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model StaffQuizAttempt {
  id               String       @id @default(uuid())
  quizId           String
  staffProfileId   String
  startedAt        DateTime     @default(now())
  submittedAt      DateTime?
  scoreObtained    Float?
  isPassed         Boolean?

  staff            StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([quizId, staffProfileId])
}

model ExamSchedule {
  id                String          @id @default(uuid())
  academicSessionId String
  subjectId         String
  name              String
  examType          String
  examDate          DateTime        @db.Date
  startTime         String
  durationMinutes   Int
  maxMarks          Float
  passMarks         Float
  weightagePercent  Float           @default(100.0)
  roomNumber        String?         @default("Examination Hall A")
  instructions      String?
  status            ExamStatus      @default(SCHEDULED)

  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  subject           Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  marks             ExamMark[]
  questionPapers    QuestionPaper[]

  @@index([academicSessionId, subjectId])
}

