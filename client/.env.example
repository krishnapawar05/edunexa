# ==============================================================================
# EduNexa Client Environment Configuration Template (client/.env.example)
# Copy to client/.env if you need to override frontend build configurations.
# ==============================================================================

# Remote backend API URL (only needed if frontend is hosted separately from backend)
# Leave unset or empty for single-service unified full-stack deployments (e.g. Railway)
# VITE_API_BASE_URL="https://your-backend.up.railway.app"

# Demo Credentials Showcase Display (Login Page)
# Controls visibility of the 9 PRD demo role quick-fill grid on the /login page.
# Default: true (visible on both localhost and Railway showcase deployments).
# Set to 'false' for live commercial school production deployments to hide demo credentials.
VITE_SHOW_DEMO_CREDENTIALS=true
